# PayPal sandbox app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: enables webhook signature verification
PAYPAL_WEBHOOK_ID=

# AI option 1 (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AI option 2: https://console.anthropic.com (used only if GROQ_API_KEY is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=3000
BASE_URL=http://localhost:3000
